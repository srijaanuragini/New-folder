# Server Configuration
PORT=3001

# AI Provider Keys (Optional: If omitted, built-in high-fidelity Mock AI Engine is used)
# Get a free Gemini API key: https://aistudio.google.com/
GEMINI_API_KEY=

# Or Groq API key: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Or OpenAI API key:
OPENAI_API_KEY=

# Or Ollama URL (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

